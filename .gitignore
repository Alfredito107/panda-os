chroot.packages.*

# Configuración generada por `lb config` (se regenera sola)
config/binary
config/bootstrap
config/chroot
config/common
config/source

# Imágenes y metadatos
*.iso
*.iso.zsync
*.iso.sha256
*.squashfs
*.packages
*.contents
*.files
*.list
*.log

# Sistema
.DS_Store
Thumbs.db
desktop.ini
