# =============================================================================
#  PandA! OS · Atributos Git
#  IMPORTANTE: los scripts (hooks de live-build, lanzadores, .desktop) deben
#  usar finales de línea LF. Si editas el repositorio en Windows, esta regla
#  evita que git los convierta a CRLF y rompan la compilación.
# =============================================================================

* text=auto eol=lf

# Scripts y configuración: siempre LF
*.sh            text eol=lf
*.hook.chroot   text eol=lf
*.desktop       text eol=lf
*.conf          text eol=lf
*.list.chroot   text eol=lf
*.desc          text eol=lf
*.qml           text eol=lf
*.yml           text eol=lf

# Binarios
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.gz        binary
*.xz        binary
*.deb       binary
*.squashfs  binary
*.iso       binary

# -----------------------------------------------------------------------------
# Git LFS (opcional). GitHub rechaza en Releases los archivos de más de 2 GB y
# en el repositorio los de más de 100 MB. El plan gratuito de LFS solo incluye
# 1 GB de almacenamiento y 1 GB/mes de ancho de banda, así que para una ISO de
# varios GB lo razonable es usar GitHub Releases (<2 GB) o un servidor externo.
# Actívalo solo si sabes lo que haces:
#
# *.iso filter=lfs diff=lfs merge=lfs -text
# *.squashfs filter=lfs diff=lfs merge=lfs -text
# -----------------------------------------------------------------------------
